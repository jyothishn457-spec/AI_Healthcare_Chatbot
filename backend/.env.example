# ============================================================
# AI Healthcare Assistant - Environment Configuration
# Copy this file to ".env" and fill in your keys, then run:
#     uvicorn main:app --reload --port 8000
# ============================================================

# LLM provider: "openai" (default) or "gemini"
LLM_PROVIDER=openai

# ---- OpenAI ----
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ---- Google Gemini ----
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.5-flash

# ---- Storage ----
DATABASE_URL=sqlite:///./chatbot.db
CHROMA_DIR=./chroma_db
DATA_DIR=../data/medical_documents

# ---- Auth (change the secret in production!) ----
SECRET_KEY=change-this-to-a-long-random-string
# Access tokens are short-lived JWTs; refresh tokens last longer and are
# revoked on logout / rotated on refresh.
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ---- RAG tuning ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=4

# ---- Rate limiting ----
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60
